     fhir:OperationDefinition.parameter.max [ fhir:value "1" ] ;
     fhir:OperationDefinition.parameter.documentation [ fhir:value "Angabe der Einwilligungsdomaene" ] ;
     fhir:OperationDefinition.parameter.type [ fhir:value "string" ]
  ], [
     fhir:index 2 ;
     fhir:OperationDefinition.parameter.name [ fhir:value "_profile" ] ;
