@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://ths-greifswald.de/fhir/gics/Parameters/IsConsented-response-example-1> a fhir:Parameters ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "IsConsented-response-example-1"] ;
  fhir:Parameters.parameter [
     fhir:index 0 ;
     fhir:Parameters.parameter.name [ fhir:value "consented" ] ;
     fhir:Parameters.parameter.valueBoolean [ fhir:value "true"^^xsd:boolean ]
  ] .

# - ontology header ------------------------------------------------------------

<https://ths-greifswald.de/fhir/gics/Parameters/IsConsented-response-example-1.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

